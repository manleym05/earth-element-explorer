{
  "name": "earth-element-explorer",
  "version": "1.0.0",
  "private": true,
  "description": "3D globe of where each element is found, produced and traded, from public geological data.",
  "scripts": {
    "sync": "python3 scripts/prepare_www.py && npx cap sync",
    "ios": "npx cap open ios",
    "android": "npx cap open android",
    "assets": "npx @capacitor/assets generate --iconBackgroundColor \"#14222e\" --splashBackgroundColor \"#14222e\"",
    "prepare-www": "python3 scripts/prepare_www.py"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "cesium": "1.145.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2"
  }
}
